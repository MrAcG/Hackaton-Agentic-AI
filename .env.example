# Backend
APP_NAME=Agentic IT Ops API
DATABASE_URL=sqlite:///./data/itsm.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Agents — use OpenAI (ChatGPT) for natural routing and replies.
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o
OPENAI_API_KEY=
AGENT_MAX_USER_TURNS=5

# Offline / deterministic mode (no API cost):
# AGENT_LLM_PROVIDER=none
